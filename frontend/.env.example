# cryptolearner.us frontend — read by Vite at `npm run build` / `npm run dev`.
# Server settings (database, JWT, uploads) live in backend/.env.

# Public site URL used in the Vue pages' canonical/OG tags (the production SITE_URL).
VITE_SITE_URL=https://www.cryptolearner.us
# API base path. Keep /api: the backend serves the site and the API together.
VITE_API_URL=/api

# Where `npm run dev` forwards /api and server-rendered pages (the backend).
VITE_DEV_API=http://localhost:3000
