# cryptolearner.us backend — copy to backend/.env and fill in MONGODB_URI.
# The backend reads only this file (or real environment variables).

PORT=3000
# development: `npm run dev`, articles rendered from the live Vue source.
# production:  the server you deploy (needs `npm run build` first).
NODE_ENV=development

# MongoDB connection string, including the database name:
#   MongoDB Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cryptolearner
#   Local MongoDB:  mongodb://127.0.0.1:27017/cryptolearner
# The server does not start without it.
MONGODB_URI=

# Signing keys for login tokens. Leave empty to have strong ones generated on
# first start (kept in backend/.runtime/secrets.json); set them explicitly when
# running more than one server.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Created on startup if no account with this email exists (password stored as
# a bcrypt hash). Change the password after the first sign-in:
#   npm run create-user -- --email admin52@gmail.com --password "<long password>"
ADMIN_EMAIL=admin52@gmail.com
ADMIN_PASSWORD=123456

# Public address of the site (canonical URLs, sitemap, RSS). In development it
# is the Vite dev server; in production e.g. https://www.cryptolearner.us
SITE_URL=http://localhost:5173

# --- Optional (defaults shown) --------------------------------------------
# JWT_EXPIRE=15m
# JWT_REFRESH_EXPIRE=30d
# ADMIN_NAME=CryptoLearner Admin
# UPLOAD_PATH=uploads          (folder inside backend/, served at /uploads)
# UPLOAD_MAX_MB=8
# TRUST_PROXY=1                (reverse proxies in front of Node; 0 = none)
# LIST_CACHE_SECONDS=30
# DB_CONNECT_ATTEMPTS=3
