{
  "name": "cryptolearner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "cryptolearner.us — Vue frontend + Express/MongoDB backend",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "start": "npm start --workspace backend",
    "release": "node scripts/package-release.mjs",
    "create-user": "npm run create-user --workspace backend --",
    "import:firestore": "npm run import:firestore --workspace backend --"
  },
  "engines": {
    "node": ">=20"
  }
}
